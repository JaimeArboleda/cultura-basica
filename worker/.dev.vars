# Variables locales para `wrangler dev` (README §4.5). Este fichero SÍ se versiona
# a propósito: el repo es privado y es el único sitio donde queda guardado el
# EXPORT_TOKEN real de producción. Si el repo deja de ser privado, rotar el token
# (`wrangler secret put EXPORT_TOKEN` desde worker/) y quitar este fichero del
# historial antes de publicar.
EXPORT_TOKEN=pGZ_SDjTUtYmFiBGHPCMYnc0ROa5L39h

# CLOUDFLARE_API_TOKEN: token de cuenta (permiso Cloudflare Pages Edit) para
# `wrangler pages deploy` / `wrangler deploy` desde entornos no interactivos
# (sin `wrangler login`). No lo lee wrangler automáticamente desde aquí: hay
# que exportarlo al entorno antes de desplegar, p.ej.:
#   export CLOUDFLARE_API_TOKEN=$(grep CLOUDFLARE_API_TOKEN worker/.dev.vars | cut -d= -f2)
# Si el repo deja de ser privado, revocar este token en el dashboard de
# Cloudflare (Perfil > API Tokens) y generar uno nuevo.
CLOUDFLARE_API_TOKEN=cfut_t5tRuzSex0zPXfXkPNVnxbNDx9wquIg6oO1pNQyubc1e5c00
